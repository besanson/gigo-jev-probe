# Placeholder values only. Real values live ONLY in .env (git-ignored) and are
# never committed, printed, or copied. Copy this file to .env and fill it in.
# JEV_API_KEY is passed to the TypeSafe SDK; TYPESAFE_API_KEY is accepted as an alias.
JEV_API_KEY=replace-with-your-typesafe-ai-api-key
# API root only: the SDK appends /v1/systemone.
JEV_BASE_URL=https://api.typesafe.ai
